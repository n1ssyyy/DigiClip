{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "DigiClip Setup",
    "version": "1.1.0",
    "identifier": "com.digiclip.setup",
    "build": {
        "devUrl": "http://localhost:1430",
        "frontendDist": "../dist",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "DigiClip Setup",
                "width": 620,
                "height": 680,
                "minWidth": 560,
                "minHeight": 620,
                "resizable": false,
                "decorations": false,
                "transparent": true
            }
        ],
        "security": {
            "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://ipc.localhost data: blob:; media-src 'self' asset: http://ipc.localhost data: blob:; style-src 'self' 'unsafe-inline' http://ipc.localhost; font-src 'self' http://ipc.localhost data:; script-src 'self' http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app", "appimage"],
        "icon": ["../../src-tauri/icons/32x32.png", "../../src-tauri/icons/128x128.png", "../../src-tauri/icons/128x128@2x.png", "../../src-tauri/icons/icon.icns", "../../src-tauri/icons/icon.ico"]
    }
}
