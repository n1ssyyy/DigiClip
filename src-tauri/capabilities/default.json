{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Main window and tray menu: core IPC (events, window APIs) plus the file dialog used by Browse.",
    "windows": ["main", "tray"],
    "permissions": ["core:default", "core:app:allow-version", "dialog:allow-open", "dialog:allow-save", "fs:allow-write-file", "core:event:allow-listen"]
}
