APP_NAME=DigiClip
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DigiClip (PLAN.MD)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TOKEN_CAP=120000
OPENROUTER_TIMEOUT_S=90
DIGICLIP_STT_MODEL=base.en
DIGICLIP_UPLOAD_MAX_MB=500

# DigiClip realtime (Reverb, localhost only)
BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=digiclip-local
REVERB_APP_KEY=local-aced8a7b1851a285dc92
REVERB_APP_SECRET=8d3dc55b02a8833bc9ebc26a4a6a64a1
VITE_REVERB_APP_KEY=local-aced8a7b1851a285dc92
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# DigiClip desktop branding (NativePHP installer + OS integration)
NATIVEPHP_APP_VERSION=1.0.1
NATIVEPHP_APP_ID=com.digiclip.app
NATIVEPHP_APP_AUTHOR=n1ssyyy
NATIVEPHP_APP_COPYRIGHT="Copyright (c) 2026 n1ssyyy"
NATIVEPHP_APP_DESCRIPTION="DigiClip, drop a video, get TikTok-ready clips"
NATIVEPHP_APP_WEBSITE=https://github.com/n1ssyyy/DigiClip
NATIVEPHP_DEEPLINK_SCHEME=digiclip
